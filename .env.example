# Copy to .env.local. Never commit real credentials.
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Ork
NEXT_PUBLIC_APP_TAGLINE=Gestão financeira para restaurantes
NEXT_PUBLIC_BRAND_COLOR="#C4622D"
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55431
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: only required for PDF extraction features that use Anthropic.
ANTHROPIC_API_KEY=
# Generated by npm run bootstrap. Public unit IDs and routing rules only.
NEXT_PUBLIC_UNIT_RULES={}
# Standalone app supports both /api and /financeiro/api.
NEXT_PUBLIC_FINANCEIRO_URL=/financeiro
